        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LTC स्टैक करने के लिए आसान चरणों का पालन करें। इसे किसी मित्र से या हमारे साझेदार MoonPay से प्राप्त करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikuti langkah mudah untuk mengumpulkan LTC. Dapatkan dari teman atau mitra kami MoonPay"
