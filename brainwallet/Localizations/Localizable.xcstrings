    "Try all features of the Brainwallet, from sending and receiving crypto to managing your keys." : {
      "comment" : "A description of the various features of the Brainwallet.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جرب جميع ميزات Brainwallet، من إرسال واستقبال العملات المشفرة إلى إدارة مفاتيحك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probieren Sie alle Funktionen der Brainwallet aus, vom Senden und Empfangen von Krypto bis hin zur Verwaltung Ihrer Schlüssel."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba todas las funciones de Brainwallet, desde el envío y la recepción de criptomonedas hasta la gestión de tus claves."
          }
        },
        "fa-IR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمام ویژگی‌های Brainwallet را امتحان کنید، از ارسال و دریافت رمزارز تا مدیریت کلیدهای خود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez toutes les fonctionnalités du Brainwallet, de l'envoi et la réception de crypto-monnaie à la gestion de vos clés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्रेनवॉलेट की सभी सुविधाओं को आज़माएं, क्रिप्टो भेजने और प्राप्त करने से लेकर अपनी कुंजियों के प्रबंधन तक।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coba semua fitur Brainwallet, dari mengirim dan menerima kripto hingga mengelola kunci Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provate tutte le funzioni di Brainwallet, dall'invio e la ricezione di crittografia alla gestione delle chiavi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号の送受信から鍵の管理まで、ブレインウォレットのすべての機能をお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화폐 송수신부터 키 관리까지 Brainwallet의 모든 기능을 시도해 보세요."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸ਼ਾਇਦ ਬਾਅਦ ਵਿੱਚ (ਛੱਡੋ)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wypróbuj wszystkie funkcje Brainwallet, od wysyłania i odbierania kryptowalut po zarządzanie kluczami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimente todos os recursos da Brainwallet, desde o envio e recebimento de criptomoedas até o gerenciamento de suas chaves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуйте все функции Brainwallet, от отправки и получения криптовалюты до управления ключами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova alla funktioner i Brainwallet, från att skicka och ta emot krypto till att hantera dina nycklar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kripto gönderip almaktan anahtarlarınızı yönetmeye kadar Brainwallet'ın tüm özelliklerini deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спробуйте всі функції Brainwallet, від надсилання та отримання криптовалюти до управління вашими ключами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体验 Brainwallet 的所有功能，从发送和接收加密货币到管理您的密钥。"
