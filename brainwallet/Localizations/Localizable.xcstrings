          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это позволит вам отправлять и получать средства с вашего предыдущего баланса. Вам нужно будет установить новый PIN-код."
          }
        },
        "sv" : {
