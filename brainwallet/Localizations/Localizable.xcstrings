          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी शब्द को देर तक दबाकर खींचें और उसे सही स्थान पर रखें"
          }
        },
        "id" : {
          "stringUnit" : {
