    "Long press & drag a word into place" : {
      "comment" : "A description below the draggable seed words, instructing the user to drag them into place.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولاً واسحب الكلمة إلى مكانها"
