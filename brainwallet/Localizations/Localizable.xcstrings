    " Tap here & top up!" : {
      "comment" : "A call-to-action text displayed below the MoonPay logo in the \"SendStep1View\".",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " انقر هنا وقم بتعبئة الرصيد!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Hier tippen & aufladen!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Toque aquí y recargue"
          }
        },
        "fa-IR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " اینجا ضربه بزنید و شارژ کنید!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Tapez ici et rechargez !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " यहाँ टैप करें और टॉप अप करें!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk di sini & isi ulang!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Toccate qui e ricaricate!"
          }
        },
        "ja" : {
          "stringUnit" : {
