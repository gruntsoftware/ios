            "value" : "ここをタップしてトップアップする！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 여기 탭하고 충전하세요!"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ਇੱਥੇ ਟੈਪ ਕਰੋ ਅਤੇ ਟੌਪ ਅੱਪ ਕਰੋ!"
          }
        },
        "pl" : {
