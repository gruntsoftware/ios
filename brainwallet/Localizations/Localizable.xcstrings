    "You cannot send if it's zero or it's syncing.\nTop up in 5 minutes with MoonPay if needed." : {
      "comment" : "Description of the first step in the send flow, explaining that the user cannot send if their balance is zero or syncing, and that they should top up in 5 minutes with MoonPay if needed.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكنك الإرسال إذا كان رصيدك صفرًا أو كان قيد المزامنة.\nيمكنك شحن رصيدك خلال 5 دقائق باستخدام MoonPay إذا لزم الأمر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können kein Geld senden, wenn der Kontostand null ist oder die Synchronisierung läuft. Laden Sie Ihr Guthaben bei Bedarf innerhalb von 5 Minuten mit MoonPay auf."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes enviar si está en cero o se está sincronizando.\nRecarga en 5 minutos con MoonPay si es necesario."
          }
        },
        "fa-IR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر صفر باشد یا در حال همگام‌سازی باشد، نمی‌توانید ارسال کنید.\nدر صورت نیاز، ظرف ۵ دقیقه با MoonPay شارژ کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pouvez pas envoyer d'argent si votre solde est nul ou en cours de synchronisation.\n\nRechargez votre compte dans 5 minutes avec MoonPay si nécessaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर यह ज़ीरो है या सिंक हो रहा है तो आप भेज नहीं सकते।\nज़रूरत पड़ने पर MoonPay से 5 मिनट में टॉप अप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tidak dapat mengirim jika nol atau sedang menyinkronkan.\nIsi ulang dalam 5 menit dengan MoonPay jika diperlukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non puoi inviare se è zero o è in sincronizzazione.\nRicarica in 5 minuti con MoonPay, se necessario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残高がゼロまたは同期中の場合には送信できません。\n必要に応じて、MoonPay で 5 分以内にチャージしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잔액이 0이거나 동기화 중일 때는 전송할 수 없습니다.\n필요한 경우 MoonPay로 5분 안에 충전하세요."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜੇਕਰ ਇਹ ਜ਼ੀਰੋ ਹੈ ਜਾਂ ਇਹ ਸਿੰਕ ਹੋ ਰਿਹਾ ਹੈ ਤਾਂ ਤੁਸੀਂ ਨਹੀਂ ਭੇਜ ਸਕਦੇ।\nਜੇਕਰ ਲੋੜ ਹੋਵੇ ਤਾਂ MoonPay ਨਾਲ 5 ਮਿੰਟਾਂ ਵਿੱਚ ਟੌਪ ਅੱਪ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie możesz wysłać, jeśli kwota wynosi zero lub jest synchronizowana.\nW razie potrzeby doładuj w 5 minut za pomocą MoonPay."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível enviar se o saldo for zero ou se estiver sincronizando.\nRecarregue em 5 minutos com o MoonPay, se necessário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не можете отправить средства, если на счету ноль или идет синхронизация.\nПри необходимости пополните счет за 5 минут с помощью MoonPay."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan inte skicka om det är noll eller om det synkroniseras.\nFyll på om 5 minuter med MoonPay om det behövs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senkronizasyon devam ederken gönderme mümkün değil. Yerel veritabanınız, ilgili işlemleri ekleyen en son bloğa kadar güncelleniyor.\n\nLütfen daha sonra tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви не можете надіслати кошти, якщо вони дорівнюють нулю або синхронізуються.\nЗа потреби поповніть рахунок за 5 хвилин за допомогою MoonPay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "余额为零或正在同步时无法发送。\n\n如有需要，可使用 MoonPay 在 5 分钟内充值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果餘額為零或正在同步，則無法傳送訊息。\n\n如有需要，請在 5 分鐘內使用 MoonPay 儲值。"
          }
        }
      }
    },
    "You didn’t forget did you? Ok! Just go back to start over." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألم تنسَ، أليس كذلك؟ حسنًا! فقط عد إلى البداية لتبدأ من جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast es nicht vergessen, oder? Ok! Geh einfach zurück und fang von vorne an."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se te olvidó, ¿verdad? ¡De acuerdo! Solo regresa para empezar de nuevo."
          }
        },
        "fa-IR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فراموش نکردی که؟ باشه! فقط برگرد تا دوباره شروع کنی."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas oublié, n’est-ce pas ? D’accord! Il suffit de revenir en arrière pour recommencer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप भूले तो नहीं? ठीक है! बस वापस जाकर दोबारा शुरू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tidak lupa, bukan? Ok! Kembali saja untuk memulai dari awal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non te ne sei dimenticato, vero? OK! Basta tornare indietro per ricominciare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忘れてないよね？分かった！やり直すために戻ればいい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잊은 건 아니지? 그래! 그냥 다시 돌아가서 처음부터 시작하세요."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਭੁੱਲੇ ਨਹੀਂ, ਕੀ ਤੁਸੀਂ? ਠੀਕ ਹੈ! ਬੱਸ ਦੁਬਾਰਾ ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਵਾਪਸ ਜਾਓ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zapomniałeś, prawda? Ok! Po prostu wróć i zacznij od nowa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não se esqueceu, não é? Ok! Basta voltar e começar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты не забыл, правда? Хорошо! Просто вернись и начни сначала."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har väl inte glömt? Okej! Gå bara tillbaka för att börja om."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unutmadın değil mi? Tamam! Baştan başlamak için geri dön."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти ж не забув, чи не так? Гаразд! Просто повернися, щоб почати спочатку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您没忘记吧？好的！返回重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您沒忘記吧？好的！返回重新開始。"
          }
        }
      }
    },
    "You have no Litecoin. Tap Buy/Recieve. Get LTC in 5 minutes with MoonPay!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس لديك Litecoin. انقر على شراء/استلام. احصل على LTC في 5 دقائق مع MoonPay!"
          }
        },
        "de" : {
